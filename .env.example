# ============================================================
# Environment variable template for the Docker stacks.
#
#   cp .env.example .env
#
# `.env` is covered by .gitignore and must never be committed. On the server it
# is rendered by Ansible (mode 0600).
#
# Without this file the observability stack deliberately refuses to start: the
# compose files fail with `GF_SECURITY_ADMIN_PASSWORD: variable is required`
# instead of bringing Grafana up with a well-known default password.
# ============================================================

# ---------- Grafana credentials ----------
# Generate a real password:
#   openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-to-a-strong-password

# ---------- Image versions ----------
# Pinned so deployments are reproducible. Changing a value here and redeploying
# is a controlled update; without pinning, `image: ...:latest` changes on its
# own and a redeploy silently changes what is running.
#
# Every tag was verified against the upstream release feed. Grafana publishes no
# floating "13.2" tag: the Docker tag carries the full version, so release
# v13.2.3 is image 13.2.3.
PROMETHEUS_VERSION=v3.15.0
ALERTMANAGER_VERSION=v0.34.1
NODE_EXPORTER_VERSION=v1.12.1
GRAFANA_VERSION=13.2.3
NGINX_VERSION=1.31-alpine
NPM_VERSION=2.16.0

# ---------- Prometheus retention ----------
# Two independent limits: by time and by size. Whichever is reached first
# applies, so the size limit acts as a safety net if series growth is worse than
# expected.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# ---------- Alert delivery ----------
# Optional. A Slack-compatible incoming webhook URL (Slack, Discord, Google Chat
# and Mattermost all accept this payload).
#
# It is a credential: anyone holding it can post to the channel. Never commit it
# and never put it in this file on a shared machine. In production it arrives as
# the Ansible variable `alertmanager_webhook_url`, fed from the GitHub secret
# ALERTMANAGER_WEBHOOK_URL.
#
# Leave it unset and Alertmanager starts with a receiver that drops
# notifications: the rules are still evaluated and visible in the UI, but no
# human is notified. Set it to turn on real delivery.
# ALERT_WEBHOOK_URL=https://hooks.example.invalid/services/T00000000/B00000000/XXXXXXXX