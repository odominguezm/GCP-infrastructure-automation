# ============================================================
# Managed by Ansible (tasks/stacks.yml). DO NOT EDIT BY HAND.
# Rendered with mode 0600 and never synced from git.
#
# The .env file stays on the server as secret material. It is not versioned, not
# logged (`no_log: true` on the task that renders it) and never overwritten with
# an empty value: if the variable arrives empty, the deployment is aborted
# rather than publishing an unusable credential.
# ============================================================

# ---------- Grafana credentials ----------
GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}

# ---------- Image versions ----------
# Pinned so that deployments are reproducible. Bumping a version here and
# redeploying is a controlled change; with `image: ...:latest` the version
# changes on its own, with nobody deciding it.
PROMETHEUS_VERSION={{ prometheus_version }}
ALERTMANAGER_VERSION={{ alertmanager_version }}
NODE_EXPORTER_VERSION={{ node_exporter_version }}
GRAFANA_VERSION={{ grafana_version }}
NGINX_VERSION={{ nginx_version }}
NPM_VERSION={{ npm_version }}

# ---------- Prometheus retention ----------
# A limit by time and by size: whichever is reached first applies. The size limit
# stops unexpected series growth from filling the 30 GB disk.
PROMETHEUS_RETENTION_TIME={{ prometheus_retention_time }}
PROMETHEUS_RETENTION_SIZE={{ prometheus_retention_size }}