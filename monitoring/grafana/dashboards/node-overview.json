      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "description": "User, system and iowait. On a shared-core e2-micro the steal time is worth watching: it is time taken by the hypervisor.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
