      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "rgba(50, 172, 45, 1)",
                "value": null
              },
              {
                "color": "rgba(237, 129, 40, 1)",
                "value": 70
              },
              {
                "color": "rgba(245, 54, 54, 1)",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "custom": {}
        },
        "overrides": []
      }
    },
