# ==========================================
# 1. TERRAFORM
# ==========================================
# Working directory: holds the provider binaries (~86 MB).
.terraform/

# State holds IPs and infrastructure metadata in cleartext. There is NO remote
# backend configured: the state is local to this machine. Back it up before
# operating (see docs/OPERACION.md) and never commit it.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variables holding real values.
# terraform.tfvars.example IS versioned: it is the documented template.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# .terraform.lock.hcl is deliberately NOT ignored: it pins exact provider
# versions and is what makes the deployment reproducible.

# ==========================================
# 2. ANSIBLE
# ==========================================
# Local inventories: they contain real lab server IPs.
hosts.ini
inventory.ini
inventory_github.ini
group_vars/all/local.yml

*.retry
.ansible_facts_cache
.ansible/

# ==========================================
# 3. SECRETS
# ==========================================
# GCP credentials. Fetch with: gcloud auth application-default login
gcp-auth.json
credentials.json
service-account*.json
keys/
*.pem
*.key
*.p12

# All SSH key material, public keys included: this repository versions none of
# it. Keys live in ~/.ssh and reach the pipeline through the SSH_PRIVATE_KEY
# secret.
id_rsa*
id_ecdsa*
id_ed25519*
id_deploy*
*.pub
# Same reasoning for the generated SSH key pair Terraform installs on the
# instance. id_deploy* above does not cover this name.
id_ansible_github*

# Docker stack environment variables.
.env
!.env.example

# Operator-created extra-vars file with the Grafana password (docs/OPERACION.md).
# The documented workflow writes `secrets.yml` in the repository root; without
# this rule a `git add -A` would commit the password.
secrets.yml
secrets.yaml
*.secrets.yml

# Generated dashboard JSON is NOT ignored on purpose: it is deployed as-is and
# CI fails if it drifts from monitoring/grafana/dashboards/build_dashboard.py.
# Ignoring it would break the deployment, which is why the generator is
# committed alongside it instead.

# ==========================================
# 4. SYSTEM AND EDITORS
# ==========================================
.vscode/
.idea/
*.swp
*.swo

.DS_Store
Thumbs.db

*.log

# Local housekeeping (old Terraform state backups, scratch files): never
# versioned. Use `.local/` instead of leaving them next to the code.
.local/

# AI session notes: personal working notes, not documentation.
.ai-context.md
# Session handover notes. Same reasoning, and this is a portfolio repository:
# these files name real infrastructure and may quote command lines that carry
# credentials, so they never belong in version control.
.sesion/